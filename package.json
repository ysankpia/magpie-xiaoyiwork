{
  "name": "magpie-xiaoyiwork",
  "version": "0.2.0",
  "description": "magpie / OpenCode provider plugin for XiaoyiWork: DeepSeek-V4, GLM-5.3, Kimi K3.1, MiniMax M3.1 and openPangu on your own account, with AI-point rates and quota cards. Sign in with a browser. Fork of Sliverkiss/magpie-xiaoyiwork with a reusable sign-in callback, duplicate-account guard, quota fallback fix, $ref inlining and a 4.5 MiB body cap. Unofficial.",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "registry-entry.json"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "opencode-auth",
    "provider",
    "xiaoyiwork",
    "celia",
    "deepseek",
    "glm"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "magpie": {
    "icon": "data:image/png;base64,",
    "maxConcurrency": 2,
    "name": "小艺Work XiaoyiWork",
    "summary": {
      "zh": "把小艺Work（华为小艺）的 DeepSeek-V4、GLM-5.3、Kimi K3.1、MiniMax M3.1、openPangu 接进 magpie，用你的华为账号浏览器登录，带 AI 点倍率与积分额度卡片。非官方。",
      "en": "Use your XiaoyiWork (Huawei Celia) models inside magpie: DeepSeek-V4, GLM-5.3, Kimi K3.1, MiniMax M3.1, openPangu — sign in with your Huawei account in a browser, with AI-point rates and quota cards. Unofficial."
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ysankpia/magpie-xiaoyiwork.git"
  },
  "scripts": {
    "check": "node --check index.mjs && node --check src/**/*.mjs",
    "test": "node --test test/*.test.mjs"
  }
}
